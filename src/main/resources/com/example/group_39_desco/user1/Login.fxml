<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group_39_desco.controller.user1.LoginController">
   <children>
      <Label fx:id="descocustomerloginLabel" layoutX="215.0" layoutY="43.0" text="DESCO Customer Login" />
      <Text layoutX="82.0" layoutY="112.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Username:" />
      <Text layoutX="85.0" layoutY="150.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password:" />
      <TextField fx:id="usernameTextField" layoutX="151.0" layoutY="95.0" />
      <PasswordField fx:id="passwordTextField" layoutX="152.0" layoutY="133.0" />
      <Button layoutX="163.0" layoutY="187.0" mnemonicParsing="false" onAction="#handleLogin" text="Loging" />
      <Button layoutX="167.0" layoutY="228.0" mnemonicParsing="false" onAction="#handleClear" text="Clear" />
   </children>
</AnchorPane>
